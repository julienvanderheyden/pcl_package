<launch>
    <!-- RealSense settings -->
    <arg name="enable_pointcloud" default="true"/>
    <arg name="align_depth" default="true"/>

    <!-- ArUco marker tracking settings -->
    <arg name="camera_namespace" default="/camera/color"/>
    <arg name="dictionary" default="DICT_5X5_50"/>
    <arg name="camera_frame" default="camera_color_optical_frame"/>
    <arg name="reference_frame" default="camera_color_optical_frame"/>
    

    <!-- Hand-Eye Calibration settings -->
    <arg name="eye_on_hand" default="false"/>
    <arg name="namespace_prefix" default="easy_handeye"/>
    <arg name="robot_base_frame" default="ra_base_link"/>
    <arg name="robot_effector_frame" default="ra_flange"/>
    <!-- <arg name="tracking_base_frame" default="camera_link"/> -->
    <arg name="tracking_base_frame" default="camera_color_optical_frame"/>
     
    <arg name="move_group" default="right_arm"/>

    <!-- 1. RealSense Driver -->
    <include file="$(find realsense2_camera)/launch/rs_camera.launch">
        <arg name="enable_pointcloud" value="$(arg enable_pointcloud)"/>
        <arg name="align_depth" value="$(arg align_depth)"/>
    </include>

    <!-- 2. Image Rectification -->
    <group ns="camera/color">
        <node pkg="image_proc" type="image_proc" name="image_proc"/>
    </group>

    <!-- IF TRACKING ARUCO -->
    <!-- <arg name="tracking_marker_frame" default="marker_6"/>
    <arg name="marker_size" default="0.1"/> -->

    <!-- 3. ArUco Marker Tracking -->
    <!-- <include file="$(find easy_aruco)/launch/track_aruco_marker.launch">
        <arg name="camera_namespace" value="$(arg camera_namespace)"/>
        <arg name="dictionary" value="$(arg dictionary)"/>
        <arg name="camera_frame" value="$(arg camera_frame)"/>
        <arg name="reference_frame" value="$(arg reference_frame)"/>
        <arg name="marker_size" value="$(arg marker_size)"/>
    </include> -->

    <!-- 4. Easy HandEye Calibration Node -->
    <!-- <include file="$(find easy_handeye)/launch/calibrate.launch">
        <arg name="eye_on_hand" value="$(arg eye_on_hand)"/>
        <arg name="namespace_prefix" value="$(arg namespace_prefix)"/>
        <arg name="robot_base_frame" value="$(arg robot_base_frame)"/>
        <arg name="robot_effector_frame" value="$(arg robot_effector_frame)"/>
        <arg name="tracking_base_frame" value="$(arg tracking_base_frame)"/>
        <arg name="tracking_marker_frame" value="$(arg tracking_marker_frame)"/>
        <arg name="move_group" value="$(arg move_group)"/>
        <arg name="freehand_robot_movement" value="false"/>
        <arg name="translation_delta_meters" value="0.2"/>
        <arg name="rotation_delta_degrees" value="35.0"/>
        <arg name="start_rviz" value="false"/>
    </include> -->
    
    <!-- IF TRACKING CHARUCO -->
    <arg name="tracking_marker_frame" default="board"/>
    <arg name="square_number_x" default="5"/>
    <arg name="square_number_y" default="5"/>
    <arg name="square_size" default="0.02"/>
    <arg name="marker_size" default="0.014"/>

    <!-- 3. Charuco Board Tracking -->
    <include file="$(find easy_aruco)/launch/track_charuco_board.launch">
        <arg name="camera_namespace" value="$(arg camera_namespace)"/>
        <arg name="dictionary" value="$(arg dictionary)"/>
        <arg name="camera_frame" value="$(arg camera_frame)"/>
        <arg name="reference_frame" value="$(arg reference_frame)"/>
        <arg name="square_number_x" value="$(arg square_number_x)"/>
        <arg name="square_number_y" value="$(arg square_number_y)"/>
        <arg name="square_size" value="$(arg square_size)"/>
        <arg name="marker_size" value="$(arg marker_size)"/>
    </include>

    <!-- 4. Easy HandEye Calibration Node -->
    <include file="$(find easy_handeye)/launch/calibrate.launch">
        <arg name="eye_on_hand" value="$(arg eye_on_hand)"/>
        <arg name="namespace_prefix" value="$(arg namespace_prefix)"/>
        <arg name="robot_base_frame" value="$(arg robot_base_frame)"/>
        <arg name="robot_effector_frame" value="$(arg robot_effector_frame)"/>
        <arg name="tracking_base_frame" value="$(arg tracking_base_frame)"/>
        <arg name="tracking_marker_frame" value="$(arg tracking_marker_frame)"/>
        <arg name="move_group" value="$(arg move_group)"/>
        <arg name="freehand_robot_movement" value="false"/>
        <arg name="translation_delta_meters" value="0.2"/>
        <arg name="rotation_delta_degrees" value="35.0"/>
        <arg name="start_rviz" value="false"/>
    </include>
</launch>